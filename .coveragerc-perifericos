# Gate periferico: views e comandos agendados.
# A cobertura atual e 81%; 70% protege a camada contra regressoes relevantes.
# Reaproveita o .coverage gerado pelo run do .coveragerc-critical.
[report]
show_missing = True
skip_covered = True
fail_under = 70
include =
    app/views.py
    app/management/commands/*
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
