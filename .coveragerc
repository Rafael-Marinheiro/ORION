[run]
branch = True
source = app
omit =
    */migrations/*
    */tests/*
    */settings.py
    */settings_test.py
    */wsgi.py
    */asgi.py

[report]
show_missing = True
skip_covered = True
fail_under = 85
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
